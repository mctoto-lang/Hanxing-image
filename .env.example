# 瀚星AI图片工作台 - 环境变量配置
# 复制此文件为 .env 并修改配置值

# 数据库：SQLite（自动创建 data/hanxing_image.db，无需配置）

# JWT 密钥（必须修改为安全的随机字符串，否则服务将拒绝启动）
JWT_SECRET=请修改为安全的随机字符串

# 数据加密密钥（用于加密 API Key、COS SecretKey 等敏感数据，必须配置）
ENCRYPTION_KEY=请修改为安全的随机字符串

# 管理员初始账号
ADMIN_USERNAME=HX2026ADMIN
# 管理员密码留空则首次启动时自动生成随机密码并输出到控制台
ADMIN_PASSWORD=

# 腾讯云 COS 配置
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_BUCKET=hanxing-image-1317363725
COS_REGION=ap-guangzhou
COS_BASE_URL=https://hanxing-image-1317363725.cos.ap-guangzhou.myqcloud.com
COS_IMAGE_PREFIX=image/
